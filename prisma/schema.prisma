datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id        String           @id @default(cuid())
  name      String
  category  String?
  ciclo     Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  versions  ArticleVersion[]

  @@unique([name, ciclo])
  @@map("articles")
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  fileSize  Int?
  mimeType  String?
  category  String?
  version   String
  author    String
  createdAt DateTime @default(now())

  @@map("article_versions")
}

model Template {
  id              String   @id @default(cuid())
  name            String
  description     String
  category        String
  fase            String?
  ciclo           Int      @default(1)
  fileUrl         String
  fileName        String?
  fileSize        Int?
  previewUrl      String?
  previewFileName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("templates")
}

